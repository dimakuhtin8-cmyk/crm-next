generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  telegramId    String?   @unique
  role          String    @default("user")
  hasOnboarded  Boolean   @default(false)
  // 2FA TOTP: secret stored encrypted, enabled only after confirm
  twoFactorSecret  String?
  twoFactorEnabled Boolean  @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  tenantMembers TenantMember[]
  sentInvites   Invite[]
  assignedTasks Task[]
  taskComments  TaskComment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  domain    String?  @unique
  logo      String?
  settings  String?

  // Telegram bot integration
  telegramBotToken       String?
  telegramWebhookSecret  String?
  telegramBotUsername    String?

  // WhatsApp Business API (360dialog)
  whatsappApiKey         String?
  whatsappAppId          String?
  whatsappWebhookSecret  String?
  whatsappPhoneNumberId  String?
  whatsappPhoneNumber    String?
  whatsappWabaId        String?  // WhatsApp Business Account ID

  // AI (Google Gemini)
  geminiApiKey           String?

  // AI Provider settings
  aiProvider             String?  @default("gemini")
  aiModel                String?
  aiApiKey               String?  // Generic field for any AI provider's key (encrypted)
  aiFallbackProvider     String?  // Fallback provider when primary fails

  // AI Usage limits (per-day, per-tenant)
  aiDailyLimit           Int      @default(1500)

  // Billing
  plan                   String   @default("free") // "free" | "starter" | "professional" | "enterprise"
  stripeCustomerId       String?  @unique
  subscriptionId         String?  // Stripe subscription ID
  subscriptionStatus     String?  @default("active") // "active" | "canceled" | "past_due" | "trialing" | "incomplete"
  subscriptionEndsAt     DateTime? // When current period ends
  trialEndsAt            DateTime? // Trial end date
  planLimits             String?   // JSON: { maxUsers, maxDeals, maxAiRequests, maxContacts }

  // External database connection
  databaseUrl            String?  // Connection string to client's own database
  databaseType           String?  @default("shared") // "shared" | "postgresql" | "mysql" | "mariadb" | "sqlserver"
  databaseStatus         String?  @default("active") // "active" | "error" | "migrating"
  databaseLastError      String?  // Last connection/migration error
  databaseConnectedAt    DateTime? // Last successful connection check

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        TenantMember[]
  invites        Invite[]
  contacts       Contact[]
  tags           Tag[]
  activities     Activity[]
  pipelines      Pipeline[]
  deals          Deal[]
  tasks          Task[]
  telegramChats  TelegramChat[]
  whatsappChats  WhatsAppChat[]
  automationRules AutomationRule[]
  automationLogs  AutomationLog[]
  aiUsageLogs     AiUsageLog[]
  aiUsageCounters AiUsageCounter[]
  payments         Payment[]
  auditLogs        AuditLog[]
}

model TelegramChat {
  id           String   @id @default(cuid())
  tenantId     String
  telegramId   Int      // Telegram user/chat ID
  firstName    String?
  lastName     String?
  username     String?
  contactId    String?  // Linked CRM contact
  firstSeenAt  DateTime @default(now())
  lastMessageAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([tenantId, telegramId])
  @@index([tenantId])
  @@index([contactId])
}

model WhatsAppChat {
  id           String   @id @default(cuid())
  tenantId     String
  phoneNumber  String   // WhatsApp phone number (E.164 format)
  name         String?  // Contact name from WhatsApp profile
  contactId    String?  // Linked CRM contact
  firstSeenAt  DateTime @default(now())
  lastMessageAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([tenantId, phoneNumber])
  @@index([tenantId])
  @@index([contactId])
}

model TenantMember {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("member")
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}

model Invite {
  id         String   @id @default(cuid())
  email      String
  tenantId   String
  role       String   @default("member")
  token      String   @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  invitedById String
  createdAt  DateTime @default(now())

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User  @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([email, tenantId])
}

model Contact {
  id        String   @id @default(cuid())
  tenantId  String
  firstName String
  lastName  String?
  email     String?
  phone     String?
  company   String?
  position  String?
  notes     String?
  source    String?
  status    String   @default("active")
  aiSummary String?
  aiAnalyzedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tags     ContactTag[]
  activities Activity[]
  deals    Deal[]
  telegramChats TelegramChat[]
  whatsappChats WhatsAppChat[]

  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, company])
  @@index([tenantId, status])
}

model Tag {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  color     String?
  createdAt DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts ContactTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ContactTag {
  id        String   @id @default(cuid())
  contactId String
  tagId     String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
}

model Activity {
  id         String   @id @default(cuid())
  tenantId   String
  contactId  String
  type       String
  title      String
  body       String?
  aiTags     String?
  aiPriority String?
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contactId])
  @@index([contactId, date])
}

model Pipeline {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  deals   Deal[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model PipelineStage {
  id         String   @id @default(cuid())
  pipelineId String
  name       String
  order      Int
  color      String?
  createdAt  DateTime @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId])
}

model Deal {
  id                 String    @id @default(cuid())
  tenantId           String
  pipelineId         String
  stageId            String
  title              String
  value              Float?
  currency           String    @default("UAH")
  probability        Int       @default(50)
  contactId          String?
  company            String?
  expectedCloseDate  DateTime?
  actualCloseDate    DateTime?
  status             String    @default("open")
  winReason          String?
  lossReason         String?
  notes              String?
  aiScore            Int?
  aiScoredAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage    PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contact  Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  products DealProduct[]

  @@index([tenantId])
  @@index([tenantId, pipelineId])
  @@index([tenantId, stageId])
  @@index([tenantId, status])
}

model DealProduct {
  id        String  @id @default(cuid())
  dealId    String
  name      String
  quantity  Int     @default(1)
  price     Float
  createdAt DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

model Task {
  id            String    @id @default(cuid())
  tenantId      String
  title         String
  description   String?
  type          String    @default("task")
  status        String    @default("todo")
  priority      String    @default("medium")
  dueDate       DateTime?
  reminderAt    DateTime?
  assigneeId    String?
  contactId     String?
  dealId        String?
  isRecurring   Boolean   @default(false)
  recurrenceRule String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee User?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  comments TaskComment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@index([tenantId, dueDate])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId])
}

model AutomationRule {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  enabled     Boolean  @default(true)

  // Trigger: when deal moves from stageX to stageY
  triggerType    String   // "stage_change", "deal_created", "deal_won", "deal_lost", "timer"
  fromStageId    String?  // null = any stage
  toStageId      String?  // null = any stage

  // Action
  actionType     String   // "set_field", "create_task", "send_notification", "move_deal", "send_message"
  actionConfig   String   // JSON config for the action

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, triggerType])
}

model AutomationLog {
  id          String   @id @default(cuid())
  tenantId    String
  ruleId      String?
  dealId      String?
  triggerType String
  actionType  String
  result      String   // "success", "error"
  details     String?  // JSON details
  executedAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, executedAt])
}

model AiUsageLog {
  id          String   @id @default(cuid())
  tenantId    String
  provider    String
  model       String
  status      String   // "success" | "error" | "rate_limited" | "timeout"
  durationMs  Int      // Request duration in milliseconds
  promptPreview String? // First 100 chars of prompt (no sensitive data)
  errorMessage String? // Error message if status != "success"
  tokensIn    Int?     // Input tokens (if available)
  tokensOut   Int?     // Output tokens (if available)
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, provider])
  @@index([tenantId, status])
}

model AiUsageCounter {
  id        String   @id @default(cuid())
  tenantId  String
  provider  String
  date      String   // "YYYY-MM-DD"
  requests  Int      @default(0)
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, date])
  @@index([tenantId])
  @@index([tenantId, date])
}

model Payment {
  id                String   @id @default(cuid())
  tenantId          String
  stripePaymentId   String?  @unique
  stripeInvoiceId   String?
  amount            Int      // Amount in cents
  currency          String   @default("usd")
  status            String   // "succeeded" | "pending" | "failed" | "refunded"
  description       String?
  planId            String?  // Which plan was purchased
  periodStart       DateTime?
  periodEnd         DateTime?
  invoiceUrl        String?  // URL to download invoice PDF
  createdAt         DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  action      String   // "create" | "update" | "delete" | "login" | "logout" | "invite" | "role_change"
  entity      String   // "contact" | "deal" | "task" | "member" | "settings" | "auth"
  entityId    String?  // ID of the affected entity
  oldValues   String?  // JSON: previous state (for updates)
  newValues   String?  // JSON: new state (for creates/updates)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([tenantId, entity])
  @@index([tenantId, userId])
}

model StripeWebhookEvent {
  id              String   @id @default(cuid())
  stripeEventId   String   @unique
  eventType       String
  status          String   @default("pending")
  processedAt     DateTime @default(now())

  @@index([stripeEventId])
  @@index([eventType])
}